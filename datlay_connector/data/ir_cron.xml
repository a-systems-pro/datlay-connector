<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- 329 D3: an app installed after connecting is read by the Datlay reader from the next day -->
    <record id="cron_sync_reader" model="ir.cron">
        <field name="name">Datlay: the reader's rights on the apps installed</field>
        <field name="model_id" ref="model_datlay_connector"/>
        <field name="state">code</field>
        <field name="code">model._cron_sync_reader()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
